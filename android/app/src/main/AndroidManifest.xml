<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Local network only. HozaSend never contacts the internet: INTERNET is
         what Android requires for any socket at all, including a UDP broadcast
         to the device next to you. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Lets discovery keep receiving broadcast packets once Wi-Fi power
         saving starts filtering them, which happens as soon as the screen
         dims. Held only while discovery is running. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Required by WifiManager.WifiLock, which keeps the radio out of its
         power-saving duty cycle while a transfer is running. Without it a
         large file with the screen off crawls and can miss enough heartbeats
         to be reported as a dropped connection. Held only for the life of a
         session; this is a normal permission with no runtime prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- A Wi-Fi lock keeps the radio awake; it does nothing about the process,
         which Android freezes shortly after the last activity stops. A user
         who switches away mid-transfer would come back to a dead connection.
         A foreground service is the sanctioned way to say this process has
         work the user asked for, and dataSync is the type that describes it:
         moving the user's own files between their own devices. Started only
         while a session is live, and stopped the moment it ends. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+. Requested at runtime; declining only costs the alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets a received APK be handed to the system installer when the user
         taps it. Without this, Android refuses before the installer is even
         reached, with no way for the user to allow it - the "install unknown
         apps" switch only exists for apps that ask for this. HozaSend never
         installs anything itself: the system prompt does, and only if the user
         agrees to it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Only for Android 9 and below, where writing into the public Downloads
         folder still meant writing a path. From API 29 MediaStore handles it
         with no permission at all, which is why this is capped. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Not asked for by HozaSend: file_picker declares it, and the manifest
         merger pulls a library's permissions into the app whether or not the
         app wants them. Capped rather than removed, because it is genuinely
         needed on older phones - but from API 33 it does nothing at all
         (Android split it into the READ_MEDIA_* permissions), and picking a
         file goes through the Storage Access Framework, which needs no
         permission on any version. Leaving it uncapped would mean a
         production app asking every modern device for blanket read access to
         its storage and never using it.

         tools:node="replace" is what makes this declaration win over
         file_picker's; without it the merger keeps the uncapped one. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:node="replace"/>

    <!-- allowBackup is off deliberately. Left on, Android backs the app's
         preferences up to the user's Google Drive and restores them onto a new
         phone - and those preferences include the identity this device
         announces itself under on the network, so a restore would put two
         devices on the same network claiming to be the same one. Nothing here
         is worth carrying across a device swap: received files live in
         Downloads and are not app data at all. -->
    <application
        android:label="HozaSend"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- What puts HozaSend in the system share sheet, next to the
                 messaging apps. Any type, because a share carries whatever the
                 other app had: a photo from the gallery, a PDF from a file
                 manager, a document from an editor. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <!-- The same thing for a multi-select: sharing thirty photos at
                 once sends a different action, and without this HozaSend would
                 be offered for one file and missing for thirty. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- Keeps the process alive while a session is live, so a transfer
             survives the user switching to another app. Not exported: nothing
             outside HozaSend has any business starting it. -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- Lets a received file be opened in the app that handles its kind.
             Another process cannot be handed a file:// URI since API 24, so a
             file opened by path goes through here instead. Only reached on
             Android 9 and below; above that a published file is a MediaStore
             URI already. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- From Android 11 an app can only see the apps it declares an
             interest in. Without this, opening a received file cannot find the
             gallery, the PDF reader or anything else that handles it, however
             many are installed. Any type, because a transfer carries whatever
             the sender picked. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- The hotspot screen has no public action, so it has to be asked for
             by class name - and from Android 11 an explicit intent to a package
             this app has not declared an interest in fails as though the
             activity did not exist. Without this the Hotspot shortcut still
             works, but always lands on the general wireless screen instead of
             the hotspot one. -->
        <package android:name="com.android.settings"/>
    </queries>
</manifest>

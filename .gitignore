# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Gradle build output. The root /build/ rule above only matches the root, so
# the Android module's own build directory needs saying separately.
/android/app/build/
/android/build/

# Build logs and other output captured while debugging a build. Never part of
# the app; the *.log rule above misses these because they are named .txt.
*-build-log.txt
*build.log
/logs/

# Tests. Kept locally, not carried in the repo.
/test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Windows installer output
/dist/

# IDE project files, regenerated on open
*.iml
*.ipr
*.iws
.idea/

# Working notes and briefs, not part of the app
CLAUDE.md*
*.md.bak

# Loose source art and captures dropped in the project root while iterating.
# Anything the repo actually needs lives in assets/ or docs/.
/*.png
/*.jpg
/*.jpeg
/Screenshot*

# ...but the README's screenshots and the app icon are part of the repo.
!/docs/screenshots/*.png
!/assets/icon/*.png

# Android release signing. The keystore itself lives outside the repo (see
# android/tool/new_release_keystore.ps1), but these rules are the belt to
# those braces: a keystore or its password must never reach a commit. Losing control
# of the key means anyone can publish an "update" Android will happily install
# over the real app.
key.properties
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.cer
*.crt

// Application-level settings for the Runner target.

// The application's name. This is what appears in the menu bar, in Finder and
// as the window title - the template's "hoza_send" would have shown the
// package name to the user everywhere macOS names an app.
PRODUCT_NAME = HozaSend

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.hozaSend

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Rahoz Osman Salim. All rights reserved.
